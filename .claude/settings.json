{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/tools/guard_bash.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/tools/guard_bash.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
